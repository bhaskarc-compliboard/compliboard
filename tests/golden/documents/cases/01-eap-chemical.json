{
  "id": "01-eap-chemical",
  "title": "Emergency Action Plan, chemical distributor, Oregon",
  "spec": "01-eap-chemical.md",
  "fixture": "fixtures/01-eap-chemical.pdf",
  "company": "cascade",
  "must": [
    { "id": "kind",
      "line": "kind: program (accept \"policy\" as a near miss, note it)",
      "type": "field_one_of", "field": "identity.kind", "accept": ["program"], "near_miss": ["policy"] },
    { "id": "agency-osha",
      "line": "agency includes OSHA (accept \"Oregon OSHA\", \"OSHA\", \"Federal OSHA\")",
      "type": "list_contains", "field": "identity.agencies", "accept": ["osha"] },
    { "id": "site-portland",
      "line": "site: Portland",
      "type": "field_contains", "field": "identity.site", "accept": ["portland"] },
    { "id": "doc-date",
      "line": "doc_date: February 2021, kind \"revised\"",
      "type": "date_prefix", "field": "identity.doc_date", "prefix": "2021-02" },
    { "id": "doc-date-kind",
      "line": "doc_date: February 2021, kind \"revised\"",
      "type": "field_contains", "field": "identity.doc_date_kind", "accept": ["revised"] },
    { "id": "jurisdiction-oregon",
      "line": "jurisdiction includes Oregon",
      "type": "list_contains", "field": "identity.jurisdiction", "accept": ["oregon"] },
    { "id": "status",
      "line": "Status (must): gaps_found. Never \"compliant\".",
      "type": "field_one_of", "field": "status", "accept": ["gaps_found"] },

    { "id": "gap-reporting",
      "line": "1. No procedure for reporting a fire or emergency. Citation contains \"1910.38(c)(1)\".",
      "type": "item", "collections": ["gaps"], "citation": "1910.38(c)(1)",
      "keywords": ["report", "reporting", "fire", "emergency", "procedure"], "min_keywords": 2,
      "locator_expected": "\"not in the document\" or section 2/3" },
    { "id": "gap-critical-operations",
      "line": "2. No procedure for employees who remain to operate critical operations before evacuating. Citation contains \"1910.38(c)(3)\".",
      "type": "item", "collections": ["gaps"], "citation": "1910.38(c)(3)",
      "keywords": ["critical operations", "remain", "shut down", "before evacuating", "operate", "stay"],
      "min_keywords": 2, "locator_expected": "\"not in the document\"" },
    { "id": "gap-contact-name",
      "line": "3. No name or job title of a person to contact for more information about the plan. Citation contains \"1910.38(c)(6)\".",
      "type": "item", "collections": ["gaps"], "citation": "1910.38(c)(6)",
      "keywords": ["name", "job title", "contact", "more information", "person"], "min_keywords": 2,
      "locator_expected": "\"not in the document\" or section 6" },

    { "id": "deadline-annual-review",
      "line": "Deadlines (must contain): annual plan review in January (source: section 6)",
      "type": "item", "collections": ["deadlines"],
      "keywords": ["annual", "january", "review", "plan"], "min_keywords": 2 },
    { "id": "deadline-drills",
      "line": "Deadlines (must contain): evacuation drills twice a year (section 4)",
      "type": "item", "collections": ["deadlines"],
      "keywords": ["drill", "twice", "year", "evacuation", "semi-annual"], "min_keywords": 2 },

    { "id": "fact-42-employees",
      "line": "Facts (must contain, quote verified true): \"42 employees at the Portland facility\" (section 1)",
      "type": "item", "collections": ["facts"],
      "keywords": ["42", "employees", "portland"], "min_keywords": 2, "quote_must_verify": true },

    { "id": "label-consistency",
      "line": "the agency label must be the same string in all three (the label list is fed back after run 1)",
      "type": "labels_identical_across_runs" }
  ],
  "must_not": [
    { "id": "no-false-alarm-gap",
      "line": "no gap claiming the alarm system is missing",
      "type": "absent_item", "collections": ["gaps"],
      "subject": ["alarm"], "absence": ["no ", "not ", "missing", "absent", "lacks", "none", "does not", "fails to", "without"] },
    { "id": "no-false-evacuation-gap",
      "line": "no gap claiming evacuation routes are missing",
      "type": "absent_item", "collections": ["gaps"],
      "subject": ["evacuation route", "exit route", "escape route", "evacuation map", "evacuation procedure"],
      "absence": ["no ", "not ", "missing", "absent", "lacks", "none", "does not", "fails to", "without"] },
    { "id": "no-false-headcount-gap",
      "line": "no gap claiming the headcount procedure is missing",
      "type": "absent_item", "collections": ["gaps"],
      "subject": ["headcount", "head count", "accounting for employees", "account for employees", "accounting for all employees"],
      "absence": ["no ", "not ", "missing", "absent", "lacks", "none", "does not", "fails to", "without"] },
    { "id": "no-false-rescue-gap",
      "line": "no gap claiming rescue/medical duties are missing",
      "type": "absent_item", "collections": ["gaps"],
      "subject": ["rescue", "medical duties", "medical dut", "first aid"],
      "absence": ["no ", "not ", "missing", "absent", "lacks", "none", "does not", "fails to", "without"] }
  ],
  "reported": [
    { "id": "freshness-five-years",
      "line": "Freshness: the scan should say the plan is more than five years old at the run date and ask whether a newer version exists.",
      "type": "text_keywords", "fields": ["freshness_note", "summary"],
      "keywords": ["five years", "5 years", "older", "newer version", "out of date", "2021"], "min_keywords": 2 },
    { "id": "fact-alarm-monitored",
      "line": "Facts may include: the alarm is monitored by Cascade Fire & Safety (section 2).",
      "type": "item", "collections": ["facts"], "keywords": ["cascade fire", "monitored", "alarm"], "min_keywords": 2 },
    { "id": "conditions-none-expected",
      "line": "Conditions: none expected (not a permit).",
      "type": "empty", "collections": ["conditions"] },
    { "id": "alarm-test-deadline",
      "line": "Alarm test first Monday monthly may appear; it is correct but not required.",
      "type": "item", "collections": ["deadlines"], "keywords": ["alarm", "monday", "monthly", "test"], "min_keywords": 2 }
  ]
}
