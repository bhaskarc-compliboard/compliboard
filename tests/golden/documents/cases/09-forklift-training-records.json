{
  "id": "09-forklift-training-records",
  "title": "Powered industrial truck operator training and evaluation records",
  "spec": "09-forklift-training-records.md",
  "dir": "tests/golden/audits",
  "fixture": "fixtures/09-forklift-training-records.pdf",
  "company": "cascade",
  "must": [
    {
      "id": "kind",
      "line": "kind: record",
      "type": "field_one_of",
      "field": "identity.kind",
      "accept": [
        "record"
      ]
    },
    {
      "id": "agency-osha",
      "line": "agency includes OSHA or Oregon OSHA, the same label string case 06 produced for this company",
      "type": "list_contains",
      "field": "identity.agencies",
      "accept": [
        "osha"
      ]
    },
    {
      "id": "subject",
      "line": "subject includes something like \"powered industrial trucks\", \"forklift\" or \"worker training\"",
      "type": "list_contains",
      "field": "identity.subjects",
      "accept": [
        "powered industrial truck",
        "forklift",
        "worker training",
        "training"
      ]
    },
    {
      "id": "site-portland",
      "line": "site: Portland",
      "type": "field_contains",
      "field": "identity.site",
      "accept": [
        "portland"
      ]
    },
    {
      "id": "doc-date",
      "line": "doc_date: June 2, 2025",
      "type": "date_equals",
      "field": "identity.doc_date",
      "value": "2025-06-02"
    },
    {
      "id": "status",
      "line": "Status (must): recorded or gaps_found. Never \"compliant\".",
      "type": "field_one_of",
      "field": "status",
      "accept": [
