    {
      "id": "deadline-chen",
      "line": "Deadlines (must contain, with dates): 1. M. Chen evaluation due March 11, 2027",
      "type": "item",
      "collections": [
        "deadlines"
      ],
      "date": "2027-03-11",
      "keywords": [
        "chen",
        "evaluation",
        "operator"
