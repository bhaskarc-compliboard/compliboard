+    returning id into rt;
+
+  -- An OPEN obligation: no close columns, no applicable_to.
+  insert into public.obligations (company_id, requirement_template_id, status)
+       values (co, rt, 'unknown') returning id into ob;
+  select count(*) into n from public.obligations
+   where id = ob and applicable_to is null and closed_by is null and closed_reason is null;
+  if n <> 1 then
+    raise exception 'MIGRATION 081 FAILED: a new obligation did not come out open with no close recorded.';
+  end if;
+
+  -- A person's close: the date, the person, the reason. And it is still "closed" by the one test
+  -- every reader uses, which is applicable_to.
+  update public.obligations
+     set applicable_to = current_date,
+         closed_reason = 'a person said these no longer apply'
+   where id = ob;
+  select count(*) into n from public.obligations where id = ob and applicable_to is not null;
+  if n <> 1 then
+    raise exception 'MIGRATION 081 FAILED: applicable_to is still what decides a row is closed, and it did not take.';
+  end if;
+  select closed_reason into v from public.obligations where id = ob;
+  if v <> 'a person said these no longer apply' then
+    raise exception 'MIGRATION 081 FAILED: closed_reason did not keep what was written to it (got %).', v;
+  end if;
+
+  -- A close the RESOLVER made keeps both columns NULL, which is how the two are told apart.
+  update public.obligations set closed_by = null, closed_reason = null where id = ob;
+  select count(*) into n from public.obligations
+   where id = ob and closed_by is null and closed_reason is null and applicable_to is not null;
+  if n <> 1 then
+    raise exception 'MIGRATION 081 FAILED: a resolver close cannot be told from a person close.';
+  end if;
+
+  delete from public.obligations where id = ob;
+  delete from public.requirement_templates where id = rt;
+  delete from public.companies where id = co;
+  raise notice 'MIGRATION 081 VERIFIED: obligations.closed_by (uuid -> auth.users, ON DELETE SET NULL) and closed_reason exist; a new row is open with neither set; a person close records the reason and the date; applicable_to is still the only test for open.';
+end $$;
+
+commit;
diff --git a/supabase/migrations/082_silence_never_closes_a_finding.sql b/supabase/migrations/082_silence_never_closes_a_finding.sql
new file mode 100644
index 0000000..4f97e7d
--- /dev/null
+++ b/supabase/migrations/082_silence_never_closes_a_finding.sql
@@ -0,0 +1,162 @@
+-- ===========================================================================
+-- 082 — SILENCE NEVER CLOSES A FINDING
+--
+-- The owner's decision **D1**, 12 October 2026
+-- (`docs/reports/jobE-independent-review.md` §7), out of E9 item 3 and N2/N3.
+--
+-- **WHY: "Audit again" closed findings the newer audit had just raised again.**
+--
+-- Measured, on real runs, in E9 item 3: two audits of one agency, 3 previous
+-- findings closed as **"not raised by the newer audit"**, and not one of them
+-- was closed because the title was worded differently. One was closed while the
+-- newer audit raised that exact title — the model's `same_as` had pointed at a
+-- row of a DIFFERENT KIND, nothing checked that the kinds agreed, so the lookup
+-- missed and the real match was closed. The other two were a `[date]` and an
+-- `[expected]`, which only a `findings` item can claim at all
+-- (`prompts/audit-agency.ts` gives `same_as` to that one list), so every re-audit
+-- closed them and raised them again: four open rows for two obligations.
+--
+-- A close is a claim to a customer — "we checked, and this is no longer raised" —
+-- it goes in the email, and a person cannot undo it. So:
+--
+--   **Only evidence closes. Silence moves an item to a group and asks.**
+--
+-- **WHAT THESE COLUMNS ARE.**
+--
+--   · `not_raised_by_run_id` — the newer run that did NOT match this older
+--     finding. The row **stays open**; this is what lets the newer run's report
+--     gather those rows under "Not raised in this audit" with a "Close it"
+--     button, instead of closing them itself. ON DELETE SET NULL, like
+--     `closed_by_run_id`: deleting a run must not take the finding with it.
+--   · `closed_by` — the login that pressed "Close it". NULL for every close the
+--     audit made on the evidence.
+--   · `closed_at` — when. `closed_by_run_id` dates a close by its run, and a
+--     person's close has no run, so the date needs a column of its own. The page
+--     renders the two together: "Closed by <name> on <date>", with **Reopen**.
+--
+-- **WHY NOT A NEW `status`.** `status` is read in ten places as open / closed /
+-- dismissed, and a fourth value would mean every one of them has to be found and
+-- taught about it — including the ones that decide what a person is shown and
+-- what the email counts. A not-raised finding IS open: that is the whole
+-- decision. So the state is a pointer to the run that went quiet about it, and
+-- every existing reader of `status` keeps being right.
+--
+-- Nothing is backfilled. Production carries 70 findings from one run and none
+-- closed (read on 12 October 2026, E10's report), so there is nothing in that
+-- state to repair; staging's two E9 runs are cleared by E10 itself.
+--
+-- No grant is needed: a new column carries the table's own grants, and
+-- `audit_findings` was granted in migration 057 and re-read in 066–068.
+-- ===========================================================================
+
+begin;
+
+alter table public.audit_findings add column if not exists not_raised_by_run_id uuid
+  references public.audit_runs(id) on delete set null;
+alter table public.audit_findings add column if not exists closed_by uuid
+  references auth.users(id) on delete set null;
+alter table public.audit_findings add column if not exists closed_at timestamptz;
+
+comment on column public.audit_findings.not_raised_by_run_id is
+  'The newer run that did not match this older finding (the owner''s decision D1, migration 082). '
+  'The finding STAYS OPEN: this is what gathers it under "Not raised in this audit" on that run''s '
+  'report, with a Close it button, instead of the audit closing it on its own silence. NULL for '
+  'every finding no newer run has gone quiet about.';
+comment on column public.audit_findings.closed_by is
+  'The login that pressed "Close it". NULL for a close the audit made on the evidence, which is '
+  'every close before 12 October 2026.';
+comment on column public.audit_findings.closed_at is
+  'When it was closed. closed_by_run_id dates a close by its run; a person''s close has no run, '
+  'so it needs its own. The page shows "Closed by <name> on <date>" with Reopen.';
+
+-- The report reads the not-raised group by the run looking at it, so that one is indexed; the
+-- other two are read from rows the same query has already returned.
+create index if not exists idx_audit_findings_not_raised_by_run
+  on public.audit_findings (not_raised_by_run_id) where not_raised_by_run_id is not null;
+
+-- ===========================================================================
+-- VERIFY — §3.7: the three columns, both deletion rules, that a not-raised
+-- finding is still OPEN, and that a person's close and an audit's close can be
+-- told apart.
+-- ===========================================================================
+do $$
+declare co uuid; r1 uuid; r2 uuid; s1 uuid; f uuid; n int; v text;
+begin
+  for v in select unnest(array['not_raised_by_run_id', 'closed_by', 'closed_at']) loop
+    if not exists (
+      select 1 from information_schema.columns
+       where table_schema = 'public' and table_name = 'audit_findings' and column_name = v
+    ) then
+      raise exception 'MIGRATION 082 FAILED: audit_findings.% is not there.', v;
+    end if;
+  end loop;
+
+  -- Both foreign keys must SET NULL, or deleting a run or an account destroys the finding.
+  select count(*) into n
+    from pg_constraint c
+    join pg_attribute a on a.attrelid = c.conrelid and a.attnum = any (c.conkey)
+   where c.conrelid = 'public.audit_findings'::regclass
+     and c.contype = 'f' and c.confdeltype = 'n'
+     and a.attname in ('not_raised_by_run_id', 'closed_by');
+  if n <> 2 then
+    raise exception 'MIGRATION 082 FAILED: expected 2 ON DELETE SET NULL keys (not_raised_by_run_id, closed_by), found %.', n;
+  end if;
+
+  if not exists (select 1 from pg_indexes
+                  where schemaname = 'public' and indexname = 'idx_audit_findings_not_raised_by_run') then
+    raise exception 'MIGRATION 082 FAILED: the not-raised group has no index, and the report reads it by that column.';
+  end if;
+
+  insert into public.companies (name) values ('082 probe') returning id into co;
+  -- `agency_label` is NOT NULL on an agency run: `audit_runs_kind_has_its_subject` requires each
+  -- kind to carry its own subject and nothing else. Found by the constraint refusing the insert.
+  insert into public.audit_runs (company_id, kind, status, section_count, done_count, agency_label)
+       values (co, 'agency', 'done', 1, 1, 'Oregon DEQ') returning id into r1;
+  insert into public.audit_runs (company_id, kind, status, section_count, done_count, agency_label, previous_run_id)
+       values (co, 'agency', 'done', 1, 1, 'Oregon DEQ', r1) returning id into r2;
+  insert into public.audit_sections (run_id, company_id, ordinal, title, status)
+       values (r1, co, 0, 'Oregon DEQ', 'done') returning id into s1;
+  insert into public.audit_findings (run_id, section_id, company_id, ordinal, kind, title)
+       values (r1, s1, co, 0, 'finding', '082 probe finding') returning id into f;
+
+  -- THE DECISION, IN ONE ASSERTION: the newer run went quiet about it, and it is still open.
+  update public.audit_findings set not_raised_by_run_id = r2 where id = f;
+  select count(*) into n from public.audit_findings
+   where id = f and status = 'open' and closed_reason is null and closed_by_run_id is null;
+  if n <> 1 then
+    raise exception 'MIGRATION 082 FAILED: a finding the newer audit did not raise must stay OPEN with no close recorded.';
+  end if;
+
+  -- A person's close: the person, the date, and a reason in their own column's words.
+  update public.audit_findings
+     set status = 'closed', closed_at = now(), closed_reason = 'closed by a person'
+   where id = f;
+  select count(*) into n from public.audit_findings
+   where id = f and status = 'closed' and closed_at is not null and closed_by_run_id is null;
+  if n <> 1 then
+    raise exception 'MIGRATION 082 FAILED: a person close did not record its date, or picked up a run id.';
+  end if;
+
+  -- REOPEN puts it back, with no trace of a close left on the row.
+  update public.audit_findings
+     set status = 'open', closed_at = null, closed_by = null, closed_reason = null
+   where id = f;
+  select count(*) into n from public.audit_findings
+   where id = f and status = 'open' and closed_at is null and closed_reason is null;
+  if n <> 1 then
+    raise exception 'MIGRATION 082 FAILED: a reopened finding still carries a close.';
+  end if;
+
+  -- And deleting the newer run leaves the finding alone, with the pointer cleared.
+  update public.audit_findings set not_raised_by_run_id = r2 where id = f;
+  delete from public.audit_runs where id = r2;
+  select count(*) into n from public.audit_findings where id = f and not_raised_by_run_id is null;
+  if n <> 1 then
+    raise exception 'MIGRATION 082 FAILED: deleting the newer run did not leave the finding with a cleared pointer.';
+  end if;
+
+  delete from public.companies where id = co;
+  raise notice 'MIGRATION 082 VERIFIED: not_raised_by_run_id, closed_by and closed_at exist; both keys SET NULL; a finding the newer audit did not raise stays OPEN with no close recorded; a person close records its date and no run; Reopen leaves no trace; and deleting the newer run clears the pointer without touching the finding.';
+end $$;
+
+commit;
diff --git a/supabase/migrations/083_a_big_drop_waits_for_a_person.sql b/supabase/migrations/083_a_big_drop_waits_for_a_person.sql
new file mode 100644
index 0000000..e444695
--- /dev/null
+++ b/supabase/migrations/083_a_big_drop_waits_for_a_person.sql
@@ -0,0 +1,126 @@
+-- ===========================================================================
+-- 083 — A BIG DROP IN THE REQUIREMENTS WAITS FOR A PERSON
+--
+-- The owner's decision **D2.1**, 12 October 2026, and the half of it that needs
+-- somewhere to live (`docs/reports/jobE-independent-review.md` §7).
+--
+-- **WHY: the note has to still be there on the next page load.**
+--
+-- D2 says that when a recompute would close all of a company's open
+-- requirements, or more than half of them, nothing closes on its own: the
+-- current list stays and a note sits on top asking "Have they stopped applying
+-- to you?" The two places that can discover this are
+--
+--   · `/api/switches/answer`, where the person has just answered a question —
+--     and D2.3 has it tell them "we've held that for you to confirm on the
+--     Requirements page"; and
+--   · `/api/obligations`, the Requirements page's own data source.
+--
+-- The page's source only resolves when `obligations_computed_at` is NULL — lazy,
+-- on first request, `DECISIONS.md` §60 — and resolving on every load would cost
+-- ~250 ms of round trips on a page that does not need it. So a hold discovered
+-- while answering a question has to be WRITTEN DOWN, or the person follows that
+-- sentence to the Requirements page and finds the old list with nothing on it
+-- explaining anything. A dead end replaced by a different dead end.
+--
+-- **WHAT THIS COLUMN IS.** The one recompute that was held, as the resolver saw
+-- it, so the page can render the note and the buttons without resolving again:
+--
+--   {
+--     "held_at":        "2026-10-12T19:00:00Z",
+--     "open_total":     200,       -- open obligations at the time
+--     "would_close":    200,       -- how many the recompute would have closed
+--     "industry":       "other",   -- the company's industry then
+--     "industry_has_library": false,
+--     "answer_changed": true       -- an answer was newer than the last compute
+--   }
+--
+-- NULL means **nothing is held**, which is the normal state. The numbers are a
+-- record of one moment and are never added up or trended: the page re-reads them
+-- to write one sentence, and the next successful recompute clears the column.
+--
+-- **WHY JSONB AND NOT SIX COLUMNS.** It is one fact — "this recompute was held,
+-- and here is what it saw" — written and cleared as a whole, by one writer, and
+-- read by one page. Six columns would make "half a hold" expressible, and the
+-- state this exists to prevent is exactly a half-recorded one.
+--
+-- **THE THRESHOLD IS NOT IN THE DATABASE.** D2.2: it is internal and no
+-- percentage is ever shown. It lives in `lib/obligationHold.ts` with the tests
+-- that pin its edges, because a rule in a column default is a rule nobody can
+-- test.
+--
+-- No grant is needed: a new column carries the table's own grants, and
+-- `companies` was granted in migrations 003–010 and re-read in 066–068.
+-- ===========================================================================
+
+begin;
+
+alter table public.companies add column if not exists obligations_hold jsonb;
+
+comment on column public.companies.obligations_hold is
+  'The one recompute of this company''s requirements that was HELD because it would have closed '
+  'all of the open list or more than half of it (the owner''s decision D2, migration 083). Holds '
+  'what the resolver saw — open_total, would_close, industry, industry_has_library, '
+  'answer_changed, held_at — so the Requirements page can write its note and draw its buttons '
+  'without resolving again. NULL means nothing is held, which is the normal state. The next '
+  'recompute that is allowed to proceed clears it.';
+
+-- No index: it is read by id, on a page that has already read the company row.
+
+-- ===========================================================================
+-- VERIFY — §3.7: the column, that NULL is the normal state, that it keeps a
+-- whole hold, and that clearing it is one statement.
+-- ===========================================================================
+do $$
+declare co uuid; v jsonb; n int;
+begin
+  if not exists (
+    select 1 from information_schema.columns
+     where table_schema = 'public' and table_name = 'companies'
+       and column_name = 'obligations_hold' and data_type = 'jsonb'
+  ) then
+    raise exception 'MIGRATION 083 FAILED: companies.obligations_hold is not there, or is not jsonb.';
+  end if;
+
+  if exists (
+    select 1 from information_schema.columns
+     where table_schema = 'public' and table_name = 'companies'
+       and column_name = 'obligations_hold' and column_default is not null
+  ) then
+    raise exception 'MIGRATION 083 FAILED: obligations_hold has a default, so every company would '
+                    'look as though something were held.';
+  end if;
+
+  insert into public.companies (name) values ('083 probe') returning id into co;
+
+  -- Nothing is held, and that is the normal state for every company that exists today.
+  select count(*) into n from public.companies where id = co and obligations_hold is null;
+  if n <> 1 then
+    raise exception 'MIGRATION 083 FAILED: a new company came out with something held.';
+  end if;
+  select count(*) into n from public.companies where obligations_hold is not null;
+  if n <> 0 then
+    raise exception 'MIGRATION 083 FAILED: % existing company rows have a hold, and nothing has written one yet.', n;
+  end if;
+
+  update public.companies set obligations_hold = jsonb_build_object(
+    'held_at', '2026-10-12T19:00:00Z', 'open_total', 200, 'would_close', 200,
+    'industry', 'other', 'industry_has_library', false, 'answer_changed', true) where id = co;
+  select obligations_hold into v from public.companies where id = co;
+  if (v -> 'would_close')::int <> 200 or (v -> 'industry_has_library')::boolean <> false
+     or v ->> 'industry' <> 'other' then
+    raise exception 'MIGRATION 083 FAILED: the hold did not come back as it was written (got %).', v;
+  end if;
+
+  -- And the next recompute that proceeds clears the whole thing, not part of it.
+  update public.companies set obligations_hold = null where id = co;
+  select count(*) into n from public.companies where id = co and obligations_hold is null;
+  if n <> 1 then
+    raise exception 'MIGRATION 083 FAILED: the hold could not be cleared.';
+  end if;
+
+  delete from public.companies where id = co;
+  raise notice 'MIGRATION 083 VERIFIED: companies.obligations_hold exists as jsonb with no default; no existing company has one; it keeps a whole hold and comes back as written; and it clears in one statement.';
+end $$;
+
+commit;
diff --git a/supabase/migrations/084_a_retry_that_never_stops_is_not_a_retry.sql b/supabase/migrations/084_a_retry_that_never_stops_is_not_a_retry.sql
new file mode 100644
index 0000000..0a9b9c5
--- /dev/null
+++ b/supabase/migrations/084_a_retry_that_never_stops_is_not_a_retry.sql
@@ -0,0 +1,120 @@
+-- ===========================================================================
+-- 084 — A RETRY THAT NEVER STOPS IS NOT A RETRY
+--
+-- **R7** (`CLAUDE.md` §3.12, added 12 October 2026), item **S1** of the
+-- independent read of Job E (`docs/reports/jobE-independent-review.md` §2).
+--
+-- **WHY: one unreachable file starves every company's documents, for ever.**
+--
+-- `app/api/jobs/scan-documents/route.ts` tells a storage error that is NOT a
+-- 404 apart from a file that is genuinely gone, and that distinction is right
+-- (`lib/storageMiss.ts`): a 404 means the file is not where its row says it is,
+-- which is a product failure said out loud on the row; anything else means we
+-- could not reach storage just now, and writing a reading on that would tell a
+-- customer to upload a second copy of a file that is still there.
+--
+-- So the row goes back to `uploaded` and the sweep moves on. And then:
+--
+--   · RULE 1 picks the globally OLDEST queued document to decide which company
+--     is next — which is this one, immediately;
+--   · it fails the same way, goes back to `uploaded`, and is picked again;
+--   · the run spins on it until the 510-second budget ends, every five minutes,
+--     and **no other company's documents are read while it lasts**.
+--
+-- E9 reported this as "costs nothing but is permanent and silent" and the
+-- independent read corrected it: it is not one stuck document, it is the whole
+-- sweep. Nothing recovers, because nothing is broken — every part is doing
+-- exactly what it was told.
+--
+-- **WHAT THIS COLUMN IS.** How many times the sweep has started reading this
+-- document and not finished. The claim increments it; a reading that lands —
+-- read or could-not-read — is the end of the story and does not clear it,
+-- because the number is about attempts and not about the current state. A
+-- person pressing "Read it again" clears it, because that is a new story and
+-- they are entitled to the same number of tries as anybody.
+--
+-- At the limit the document stops being retried and says so, in the owner's
+-- words, and its batch finishes so the email goes — which is the half of S1
+-- that matters most: a batch that never finishes is a person waiting for an
+-- email that will never arrive.
+--
+-- **WHY NOT A TIMESTAMP INSTEAD.** A backoff on `reading_since` would make the
+-- sweep try less often; it would not make it stop, and "less often, for ever"
+-- is still for ever. The question the sweep has to be able to answer is "have
+-- we tried this enough", and that is a count.
+--
+-- NOT NULL DEFAULT 0, so every existing row starts with a clean slate: no
+-- document is retired by this migration, which is the direction that cannot
+-- lose anything.
+--
+-- No grant is needed: a new column carries the table's own grants, and
+-- `documents` was granted in migrations 003–010 and re-read in 066–068.
+-- ===========================================================================
+
+begin;
+
+alter table public.documents
+  add column if not exists read_attempts integer not null default 0;
+
+comment on column public.documents.read_attempts is
+  'How many times the sweep has started reading this document and not finished (R7, item S1, '
+  'migration 084). The claim increments it; a landed reading leaves it alone; a person pressing '
+  '"Read it again" clears it. At READ_ATTEMPT_LIMIT the sweep stops retrying, says so on the row, '
+  'and lets the batch finish so the email goes. 0 for every row that existed before 12 October '
+  '2026 — this migration retires nothing.';
+
+-- No index: it is read from rows the queue query has already narrowed by company and status.
+
+-- ===========================================================================
+-- VERIFY — §3.7: the column, its default and NOT NULL, that it counts, and
+-- that it can be cleared.
+-- ===========================================================================
+do $$
+declare co uuid; d uuid; n int;
+begin
+  if not exists (
+    select 1 from information_schema.columns
+     where table_schema = 'public' and table_name = 'documents'
+       and column_name = 'read_attempts' and data_type = 'integer'
+       and is_nullable = 'NO' and column_default = '0'
+  ) then
+    raise exception 'MIGRATION 084 FAILED: documents.read_attempts is not an integer NOT NULL DEFAULT 0.';
+  end if;
+
+  -- Nothing that already exists is retired by this.
+  select count(*) into n from public.documents where read_attempts <> 0;
+  if n <> 0 then
+    raise exception 'MIGRATION 084 FAILED: % existing document(s) came out with attempts against them.', n;
+  end if;
+
+  insert into public.companies (name) values ('084 probe') returning id into co;
+  insert into public.documents (company_id, name, file_url, file_type, status)
+       values (co, '084 probe.pdf', co || '/084.pdf', 'application/pdf', 'uploaded')
+    returning id into d;
+
+  select read_attempts into n from public.documents where id = d;
+  if n <> 0 then
+    raise exception 'MIGRATION 084 FAILED: a new document did not start at 0 (got %).', n;
+  end if;
+
+  -- It counts, the way the claim counts it.
+  update public.documents set read_attempts = read_attempts + 1 where id = d;
+  update public.documents set read_attempts = read_attempts + 1 where id = d;
+  select read_attempts into n from public.documents where id = d;
+  if n <> 2 then
+    raise exception 'MIGRATION 084 FAILED: the column did not count (got %).', n;
+  end if;
+
+  -- And a person pressing "Read it again" clears it.
+  update public.documents set read_attempts = 0 where id = d;
+  select read_attempts into n from public.documents where id = d;
+  if n <> 0 then
+    raise exception 'MIGRATION 084 FAILED: the count could not be cleared.';
+  end if;
+
+  delete from public.documents where id = d;
+  delete from public.companies where id = co;
+  raise notice 'MIGRATION 084 VERIFIED: documents.read_attempts is an integer NOT NULL DEFAULT 0; no existing row carries an attempt; it counts and it clears.';
+end $$;
+
+commit;
