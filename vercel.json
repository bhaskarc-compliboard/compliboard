{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/jobs/summarise",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/jobs/delete",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/jobs/scan-documents",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/audit-sections",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/handbook-queue",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/jobs/handbook-checks",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/calendar-month",
      "schedule": "0 14 1 * *"
    }
  ],
  "functions": {
    "app/api/jobs/scan-documents/route.ts": {
      "memory": 2048,
      "maxDuration": 800
    },
    "app/api/document-scan/route.ts": {
      "memory": 2048,
      "maxDuration": 800
    }
  }
}
