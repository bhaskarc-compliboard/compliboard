# CompliBoard — environment variables
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed, zipped, or shared.
#
#   cp .env.example .env.local
#
# When sending the codebase to anyone, exclude env files:
#   zip -r cb.zip Compliboard -x "*/node_modules/*" "*.env*" "*/.next/*" "*/.git/*"


# ── AI ────────────────────────────────────────────────────────────────────────
# Server-side only. Must never reach the browser — no NEXT_PUBLIC_ prefix, ever.
# Used only by lib/ai.ts, which is the single call site for every AI request.
ANTHROPIC_API_KEY=

# Optional overrides. Leave unset to use the defaults in lib/ai.ts.
# AI_PROVIDER=claude
# AI_MODEL=claude-sonnet-4-5


# ── Supabase: client-side ─────────────────────────────────────────────────────
# NEXT_PUBLIC_ vars are compiled into the browser bundle. That is fine here:
# the anon key is designed to be public, and RLS is the actual security boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── Supabase: server-side ─────────────────────────────────────────────────────
# The service-role key BYPASSES RLS ENTIRELY. Anyone holding it has full read and
# write access to every table for every customer.
#
# Permitted only where no user session exists: the background worker, the cron
# route, and signup. Anywhere else it is a bug — derive company_id from the
# verified session token instead (see app/api/folders/industry/route.ts).
#
# Verify it has not leaked into client code:
#   grep -rn "SERVICE_ROLE" app components
SUPABASE_SERVICE_ROLE_KEY=


# ── Supabase: migrations and type generation ──────────────────────────────────
# There are TWO separate sets of values here, one per database, and the scripts
# never mix them. Which set is used depends entirely on the command you run:
#
#   npm run db:migrate        -> STAGING     (the three SUPABASE_* values below)
#   npm run db:migrate:prod   -> PRODUCTION  (the three SUPABASE_PROD_* values)
#
# If a value needed by the chosen target is missing, the script stops and names it.
# It will never quietly borrow the other environment's value to fill the gap — that
# substitution is how a migration meant for staging ends up on production.
#
# Where to find each value, for either project:
#   Reference ID:      dashboard -> Settings -> General
#   Database password: dashboard -> Settings -> Database
#   Pooler host:       dashboard -> Settings -> Database -> Connection string
#                      -> Session pooler   (e.g. aws-0-us-west-2.pooler.supabase.com)
#
# The session pooler is used rather than the direct DB host because the direct
# host is IPv6-only and unreachable from most networks. The pooler host differs
# per project when the two projects are in different regions — do not assume the
# staging host works for production. Copy each one from its own dashboard.

# --- STAGING: the default target. Everyday development uses these. -------------
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_POOLER_HOST=

# --- PRODUCTION: used ONLY by npm run db:migrate:prod --------------------------
# Applying anything here changes the live database customers depend on. The script
# prints the target ref, lists the migrations it is about to apply, and requires you
# to type the word PRODUCTION before it will proceed. It also refuses to run at all
# if SUPABASE_PROD_REF and SUPABASE_PROJECT_REF are the same project, because then
# there is no safe place to test a migration first.
#
# Leave these blank until you actually need to ship a migration. A blank value here
# cannot cause an accident; a wrong one can.
SUPABASE_PROD_REF=
SUPABASE_PROD_DB_PASSWORD=
SUPABASE_PROD_POOLER_HOST=

# Account-level personal access token for type generation. One token covers both
# projects, so there is no separate production version of this value.
# Create at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=


# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
FEEDBACK_EMAIL=


# ── Cron ──────────────────────────────────────────────────────────────────────
# Shared secret the monthly-summary cron route checks before running.
# Any long random string. Regenerate with: openssl rand -hex 32
CRON_SECRET=
