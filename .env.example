# CompliBoard — environment variables
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed, zipped, or shared.
#
#   cp .env.example .env.local
#
# When sending the codebase to anyone, exclude env files:
#   zip -r cb.zip Compliboard -x "*/node_modules/*" "*.env*" "*/.next/*" "*/.git/*"


# ── AI ────────────────────────────────────────────────────────────────────────
# Server-side only. Must never reach the browser — no NEXT_PUBLIC_ prefix, ever.
# Used only by lib/ai.ts, which is the single call site for every AI request.
ANTHROPIC_API_KEY=

# Optional overrides. Leave unset to use the defaults in lib/ai.ts.
# AI_PROVIDER=claude
# AI_MODEL=claude-sonnet-4-5


# ── Supabase: client-side ─────────────────────────────────────────────────────
# NEXT_PUBLIC_ vars are compiled into the browser bundle. That is fine here:
# the anon key is designed to be public, and RLS is the actual security boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── Supabase: server-side ─────────────────────────────────────────────────────
# The service-role key BYPASSES RLS ENTIRELY. Anyone holding it has full read and
# write access to every table for every customer.
#
# Permitted only where no user session exists: the background worker, the cron
# route, and signup. Anywhere else it is a bug — derive company_id from the
# verified session token instead (see app/api/folders/industry/route.ts).
#
# Verify it has not leaked into client code:
#   grep -rn "SERVICE_ROLE" app components
SUPABASE_SERVICE_ROLE_KEY=


# ── Supabase: migrations and type generation ──────────────────────────────────
# SUPABASE_PROJECT_REF decides which database npm run db:migrate targets.
# Set it to the STAGING ref while developing. Switch to production only to ship.
#
#   Reference ID:      dashboard -> Settings -> General
#   Database password: dashboard -> Settings -> Database
#   Pooler host:       dashboard -> Settings -> Database -> Connection string
#                      -> Session pooler   (e.g. aws-0-us-west-2.pooler.supabase.com)
#
# The session pooler is used rather than the direct DB host because the direct
# host is IPv6-only and unreachable from most networks.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_POOLER_HOST=

# Production ref, used only so db-migrate.js can warn you before touching prod.
SUPABASE_PROD_REF=

# Account-level personal access token for type generation.
# Create at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=


# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
FEEDBACK_EMAIL=


# ── Cron ──────────────────────────────────────────────────────────────────────
# Shared secret the monthly-summary cron route checks before running.
# Any long random string. Regenerate with: openssl rand -hex 32
CRON_SECRET=
